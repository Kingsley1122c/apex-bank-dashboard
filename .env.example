# Core app settings
NODE_ENV=production
PORT=8787
VITE_API_BASE_URL=

# Production persistence (recommended for hosted environments)
DATABASE_URL=
DATABASE_SSL=false

# Email sender identity
EMAIL_FROM=Apex Bank <no-reply@example.com>

# SendGrid configuration (recommended on Render free because SMTP ports are blocked)
SENDGRID_API_KEY=

# SMTP configuration (optional fallback for environments that allow SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password